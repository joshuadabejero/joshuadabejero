
# ==========================================
# FRONTEND - Nuxt Public Configuration
# ==========================================

# Google reCAPTCHA Site Key (public)
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ==========================================
# BACKEND - Google reCAPTCHA
# ==========================================

# Google reCAPTCHA Legacy Secret Key (private)
RECAPTCHA_SECRET_KEY=

# Allowed hostname (localhost for development)
SITE_HOSTNAME=

# ==========================================
# BACKEND - EmailJS
# ==========================================

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# EmailJS Private Key (keep server-side only)
EMAILJS_PRIVATE_KEY=
